<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.external.liba.dao.LegacyAS400Dao">

    <!-- 外部 JAR A 自己的 MyBatis Mapper XML -->
    <!-- 雖然目前 DAO 是直接用 JDBC + Connection，但保留 Mapper 設定備用 -->

    <select id="queryActiveCustomers" resultType="string">
        SELECT customer_name FROM customers WHERE status = 'ACTIVE'
    </select>

    <insert id="insertCustomer" parameterType="map">
        INSERT INTO customers (customer_name, status) VALUES (#{customerName}, 'ACTIVE')
    </insert>

</mapper>
